# SENDO-BACKEND environment example (copy to .env and fill values)

PORT=3001
JWT_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Maps (server) — Distance Matrix, Routes API, Weather API; prefer a restricted server key
GOOGLE_MAPS_API_KEY=

# Paystack — checkout “Pay online now” (initialize + verify). Wallet virtual accounts stay on Seerbit.
PAYSTACK_SECRET_KEY=sk_test_or_live_...
PAYSTACK_PUBLIC_KEY=pk_test_or_live_...
PAYSTACK_CALLBACK_URL=https://sendo-pay-callback.netlify.app

# Seerbit — wallet funding / virtual accounts (unchanged)
# SEERBIT_PUBLIC_KEY=
# SEERBIT_SECRET_KEY=
# SEERBIT_PRIVATE_KEY=

# Optional legacy (unused by runtime)
# MAPBOX_ACCESS_TOKEN=
